{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ods:i8:piece-analysis:1.0",
  "title": "Strict I8 producer 6c 1.0",
  "type": "object",
  "required": ["message_type", "message_id", "schema", "schema_version", "producer", "published_at", "captured_at", "source_id", "session_id", "sequence", "artifact_version", "payload"],
  "additionalProperties": false,
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "text": {"type": "string", "pattern": "\\S"},
    "ratio": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "properties": {
    "message_type": {"const": "event"}, "message_id": {"$ref": "#/$defs/uuid"},
    "schema": {"const": "ods.i8.piece_analysis"}, "schema_version": {"const": "1.0"},
    "producer": {"const": "I8"}, "published_at": {"$ref": "#/$defs/time"},
    "captured_at": {"$ref": "#/$defs/time"}, "source_id": {"$ref": "#/$defs/text"},
    "session_id": {"$ref": "#/$defs/uuid"}, "sequence": {"type": "integer", "minimum": 0},
    "artifact_version": {"$ref": "#/$defs/text"}, "correlation_id": {"$ref": "#/$defs/uuid"},
    "payload": {
      "type": "object",
      "required": ["frame_index", "detection_id", "bbox", "result", "taxonomy_version", "confidence", "similarity"],
      "additionalProperties": false,
      "properties": {
        "frame_index": {"type": "integer", "minimum": 0}, "detection_id": {"type": "integer", "minimum": 0},
        "bbox": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4},
        "result": {"enum": ["CONFORMING", "NON_CONFORMING", "ANOMALY", "UNCERTAIN"]},
        "taxonomy_version": {"$ref": "#/$defs/text"}, "confidence": {"$ref": "#/$defs/ratio"},
        "similarity": {"$ref": "#/$defs/ratio"}, "defect_class": {"$ref": "#/$defs/text"}
      },
      "if": {"properties": {"result": {"const": "NON_CONFORMING"}}},
      "then": {"required": ["defect_class"]}, "else": {"not": {"required": ["defect_class"]}}
    }
  },
  "$comment": "Runtime also verifies bbox area, finite values and loaded taxonomy class/version. Strict producer 1.0, not A1 compatible consumer."
}
