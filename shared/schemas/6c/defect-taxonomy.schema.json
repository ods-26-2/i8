{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ods:defect-taxonomy:1.0",
  "type": "object", "required": ["classes"], "additionalProperties": false,
  "properties": {
    "classes": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["defect_class", "name", "description", "severity"], "additionalProperties": false,
      "properties": {
        "defect_class": {"type": "string", "pattern": "\\S", "not": {"const": "NORMAL"}},
        "name": {"type": "string", "pattern": "\\S"}, "description": {"type": "string", "pattern": "\\S"},
        "severity": {"type": "string", "pattern": "\\S"}
      }
    }}
  },
  "$comment": "Project decisions: required nonempty class fields/list, unique IDs (runtime), NORMAL only legacy. No invented severity enum."
}
